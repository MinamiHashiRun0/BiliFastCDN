#!name=BiliFastCDN · B站CDN加速
#!desc=v1.1.1 · 请求侧后端移植自 Biliverse/Redirect，目标主机由自动测速排名决定（可填固定主机），附状态面板。
#!system=ios
#!arguments=hostOverseaVideo:auto,hostBStar:auto,hostPcdn:auto,hostMcdn:proxy-tf-all-ws.bilivideo.com,notify:true,debug:false
#!arguments-desc=hostOverseaVideo:港澳台（*ov、cn-hk-eq-*）与 Akamai 分片的目标主机。填 auto = 用测速最快；填主机名 = 固定用它。 hostBStar:国际版（*bstar1）的目标主机，auto 同上。 hostPcdn:大陆镜像与 PCDN 的目标主机，auto 同上。 hostMcdn:MCDN（:4483/:9102）的代理包裹目标，默认 proxy-tf-all-ws.bilivideo.com。 notify:测速完成后是否发通知。 debug:把每次判定写进请求详情注释。
#
# 版本号出现在两处，发版时一起改：#!desc 与下面三条 script-path 的 ?v=。
# 两个脚本（bili-cdn.js / bili-speedtest.js）的 VERSION 用同一个值。
#
# 结构：
#   1. [General] force-http-engine-hosts：让 Surge 把这些主机/端口的 TCP 也按 HTTP 处理。
#   2. [Script] 请求改写：判定逐条对照 Redirect 的 Request.mjs（港澳台/国际版/Akamai 分组、
#      MCDN 换端口与 cdn/sid、PCDN :4480 与 :9305、:4483/:9102 代理包裹）。
#      目标主机可以填 auto —— 那就用测速排名第一，所以改写必须走脚本：静态 [URL Rewrite]
#      只能用固定值。
#   3. [Script] 测速（cron，默认 30 分钟一次，结果满 6 小时才重测）+ 面板。
#   4. [Panel]：卡片显示最快节点、测速时间、改写计数与最近一次改写；点刷新按钮立即重测。
#
# 与「BiliFastCDN (PlayURL)」那个模块二选一：那个是响应侧改写 playurl，本模块是请求侧改写。
# 两个都装会让同一条请求被两条路径改写，没必要。

[General]
force-http-engine-hosts = %APPEND% upos-*.bilivideo.com:80, cn-hk-eq-*.bilivideo.com:80, upos-*-mirrorakam.akamaized.net:80, *:4480, *:4483, *:486, *:8000, *:8082, *:9102, *:9305

[Script]
BiliFastCDN-CDN = type=http-request,pattern=^https?://(upos-[a-z0-9-]+\.bilivideo\.(com|cn|net)|cn-hk-eq-[a-z0-9-]+\.bilivideo\.com|upos-[a-z0-9-]+-mirrorakam\.akamaized\.net|[adbcefxy0-9]+\.mcdn\.bilivideo\.cn|[^/]+:(4480|9305))(?::[0-9]+)?/,timeout=5,script-path=https://raw.githubusercontent.com/MinamiHashiRun0/BiliFastCDN/main/bili-cdn.js?v=1.1.1,script-update-interval=1800,debug={{{debug}}},argument=hostOverseaVideo={{{hostOverseaVideo}}}&hostBStar={{{hostBStar}}}&hostPcdn={{{hostPcdn}}}&hostMcdn={{{hostMcdn}}}&debug={{{debug}}}
BiliFastCDN-Probe = type=cron,cronexp="*/30 * * * *",timeout=60,script-path=https://raw.githubusercontent.com/MinamiHashiRun0/BiliFastCDN/main/bili-speedtest.js?v=1.1.1,script-update-interval=1800,argument=notify={{{notify}}}&debug={{{debug}}}
BiliFastCDN-Panel = type=generic,timeout=30,script-path=https://raw.githubusercontent.com/MinamiHashiRun0/BiliFastCDN/main/bili-speedtest.js?v=1.1.1,script-update-interval=1800,argument=notify={{{notify}}}&debug={{{debug}}}

[Panel]
BiliFastCDN = title="B站CDN",content="加载中",style=info,script-name=BiliFastCDN-Panel,update-interval=1

# 明文 http（官方 App 的分片）不需要 MitM；这里列的是 https 分片要被改写时需要的解密主机。
[MITM]
hostname = %APPEND% upos-*.bilivideo.com, cn-hk-eq-*.bilivideo.com, upos-*-mirrorakam.akamaized.net, *.mcdn.bilivideo.cn
