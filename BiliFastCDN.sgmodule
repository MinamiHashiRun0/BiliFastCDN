#!name=BiliFastCDN · B站CDN加速
#!desc=v0.3.0 · 劫持 B 站 playurl / 直播 playinfo 接口，把视频 CDN 域名重写为实测最快的节点。
#!system=ios
#!arguments=enabled:true,mode:smart,grpcRewrite:true,grpcGunzip:false,mediaRewrite:true,hostPcdn:auto,hostOversea:auto,hostBStar:auto,hostMcdn:proxy-tf-all-ws.bilivideo.com,backupFanout:true,liveFilter:true,notify:true,debug:false
#!arguments-desc=enabled:总开关。 mode:改写策略（smart 接口层全量改写、分片层与字节层只改写劣质节点；force 全量改写，分片层全量会让播放器失去主备冗余，慎用；bad-only 只改写 PCDN/劣质节点；off 关闭改写）。 grpcRewrite/mediaRewrite:分别开关 gRPC 与明文 http 分片两层。 grpcGunzip:是否解开 gzip 帧后再改 gRPC（App 的 playurl 实测全是 gzip 帧，不开则字节层一次也改不动；开启后改写过的帧按未压缩帧发回，客户端不认就会整条 playurl 失败，所以默认关）。 hostPcdn/hostOversea/hostBStar:分类目标覆盖，填 auto 表示用测速排名第一，填主机名则固定用它（分别对应大陆、港澳台 *ov 与 cn-hk-eq-*、国际版 *bstar1）。 hostMcdn:MCDN 的目标节点，默认 proxy-tf-all-ws.bilivideo.com（代理包裹）。 backupFanout:是否把候选节点写入 backupUrl。 liveFilter:是否从直播 url_info 中剔除 PCDN 节点。 notify:测速完成后是否发通知。 debug:把每次判定写进日志与请求详情注释，每次改写发一条通知（30 秒内不重复）。
#
# 版本号出现在三处，发版时一起改：本行上方的 #!desc、下面五条 script-path 的 ?v=、
# 以及 bili-cdn.js 里的 VERSION。Surge 对模块与远程脚本都会缓存，版本号是判断
# "设备上到底加载了哪一版"的唯一依据（模块列表看 desc，面板标题看 VERSION）。
#
# 安装：本文件与 bili-cdn.js 放进 Surge 目录 → 模块里启用 → 打开 MitM 总开关并信任证书。
# 没有 MitM 脚本不会执行，模块等同于没开。用法、参数、已知限制见仓库 README。
# 生效判断看策略页「B站CDN」卡片的两行计数：
#   接口 触发/媒体/改写 = 网页版 playurl 那层（需要 MitM）
#   分片 改写/总数      = 明文 http 分片那层（不需要 MitM）
# 分片层在 smart 下只修劣质节点，扫描有数、改写 0 是常态，卡片会自己写这行说明。
# 点卡片刷新按钮立即测速；debug 打开后判定会写进「请求详情 → 注释」，日志页需要 loglevel=info。

[Script]
BiliFastCDN-Rewrite = type=http-response,pattern=^https?://(api\.bilibili\.com|app\.bilibili\.com|api\.live\.bilibili\.com|api\.biliapi\.net|api\.snm0516\.aisee\.tv)/(x/player/(wbi/)?playurl|pgc/player/(api|web)/(v2/)?playurl|xlive/web-room/v[12]/index/getRoomPlayInfo),requires-body=1,max-size=10485760,timeout=20,script-path=https://raw.githubusercontent.com/MinamiHashiRun0/BiliFastCDN/main/bili-cdn.js?v=0.3.0,script-update-interval=1800,debug={{{debug}}},argument=enabled={{{enabled}}}&mode={{{mode}}}&hostPcdn={{{hostPcdn}}}&hostOversea={{{hostOversea}}}&hostBStar={{{hostBStar}}}&hostMcdn={{{hostMcdn}}}&backupFanout={{{backupFanout}}}&liveFilter={{{liveFilter}}}&notify={{{notify}}}&debug={{{debug}}}
# gRPC / protobuf：App 的 playurl 走这里。binary-body-mode 让 body 以 Uint8Array 传入，
# 默认引擎即可（不需要 engine=webview）。判定按 body 内容做，不按方法名写死 ——
# 以后 B 站再迁新方法（例如分区页 regionv2），把方法名加进下面的 pattern 即可。
# max-size 是缓冲上限：超过就整条跳过（iOS 上过大会占 NE 进程内存），默认 1MB 偏小。
BiliFastCDN-gRPC = type=http-response,pattern=^https?://(grpc\.biliapi\.net|app\.bilibili\.com|app\.biliapi\.net)/.*(PlayViewUnite|PlayView|PlayConf|PlayURL)(\?.*)?$,requires-body=1,binary-body-mode=1,max-size=4194304,timeout=10,script-path=https://raw.githubusercontent.com/MinamiHashiRun0/BiliFastCDN/main/bili-cdn.js?v=0.3.0,script-update-interval=1800,debug={{{debug}}},argument=enabled={{{enabled}}}&mode={{{mode}}}&grpcRewrite={{{grpcRewrite}}}&grpcGunzip={{{grpcGunzip}}}&hostPcdn={{{hostPcdn}}}&hostOversea={{{hostOversea}}}&hostBStar={{{hostBStar}}}&hostMcdn={{{hostMcdn}}}&debug={{{debug}}}
BiliFastCDN-Media = type=http-request,pattern=^http://[a-zA-Z0-9.-]+\.(bilivideo\.(com|cn|net)|akamaized\.net)(:[0-9]+)?/,timeout=5,script-path=https://raw.githubusercontent.com/MinamiHashiRun0/BiliFastCDN/main/bili-cdn.js?v=0.3.0,script-update-interval=1800,debug={{{debug}}},argument=enabled={{{enabled}}}&mode={{{mode}}}&mediaRewrite={{{mediaRewrite}}}&hostPcdn={{{hostPcdn}}}&hostOversea={{{hostOversea}}}&hostBStar={{{hostBStar}}}&hostMcdn={{{hostMcdn}}}&debug={{{debug}}}
BiliFastCDN-Probe = type=cron,cronexp="*/30 * * * *",timeout=60,script-path=https://raw.githubusercontent.com/MinamiHashiRun0/BiliFastCDN/main/bili-cdn.js?v=0.3.0,script-update-interval=1800,argument=enabled={{{enabled}}}&mode={{{mode}}}&notify={{{notify}}}&debug={{{debug}}}
BiliFastCDN-Panel = type=generic,timeout=30,script-path=https://raw.githubusercontent.com/MinamiHashiRun0/BiliFastCDN/main/bili-cdn.js?v=0.3.0,script-update-interval=1800,argument=enabled={{{enabled}}}&mode={{{mode}}}&notify={{{notify}}}&debug={{{debug}}}

# 点刷新按钮 = 立即测速；自动刷新只读缓存，不发请求。
[Panel]
BiliFastCDN = title="B站CDN",content="点刷新按钮测速",style=info,script-name=BiliFastCDN-Panel,update-interval=1

[MITM]
hostname = %APPEND% api.bilibili.com, app.bilibili.com, grpc.biliapi.net, app.biliapi.net, api.live.bilibili.com, api.biliapi.net, api.snm0516.aisee.tv
